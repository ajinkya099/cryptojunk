# IGA AI Framework — Environment Configuration
# Copy this to .env and fill in real values

# ── Anthropic (required for AI agents) ──────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Database ─────────────────────────────────────────────────────
# PostgreSQL (production)
DATABASE_URL=postgresql+asyncpg://iga_user:iga_password@localhost:5432/iga_db
# SQLite (development/testing — faster startup)
# DATABASE_URL=sqlite+aiosqlite:///./iga_dev.db

# ── Redis (Celery broker) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ─────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Application ──────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── IGA Agent Configuration ──────────────────────────────────────
# Claude model for AI agents
AGENT_MODEL=claude-sonnet-4-6
# Maximum tokens per agent response
AGENT_MAX_TOKENS=4096
# Agent decision confidence threshold (0.0-1.0)
AGENT_CONFIDENCE_THRESHOLD=0.85
# Dry run: agents log decisions but don't execute (set to false in production)
AGENT_DRY_RUN=true

# ── Certification Campaign Settings ──────────────────────────────
CERT_CAMPAIGN_AUTO_APPROVE_THRESHOLD=0.95
CERT_CAMPAIGN_AUTO_REVOKE_THRESHOLD=0.80
CERT_CAMPAIGN_DEFAULT_DURATION_DAYS=14

# ── SoD Policy Settings ───────────────────────────────────────────
SOD_AUTO_REMEDIATE=false
SOD_ALERT_EMAIL=iga-alerts@example.com
